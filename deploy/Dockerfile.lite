# =============================================================================
# homevault 精简版镜像（约 25–40 MB）
#
#   docker build -f deploy/Dockerfile.lite -t homevault:lite .
#   docker run -d --name homevault -p 127.0.0.1:8080:8080 \
#     -v "$PWD/data:/data" --restart unless-stopped homevault:lite
#
# 特点：只有 homevault 本体。Word/Excel/PPT 这类文件不会做服务端转换，
#       前端会退化为"提示下载查看"（接口返回 409 office_preview_unavailable）。
#       需要服务端 Office→PDF 预览请改用 deploy/Dockerfile.full。
#
# 注意：构建上下文是**仓库根目录**（不是 deploy/），因为需要 go.mod / main.go /
#       internal/ / web/。如果你在 deploy/ 目录里执行 docker build，请改成
#       `docker build -f Dockerfile.lite -t homevault:lite ..`
# =============================================================================

# ---------------------------------------------------------------------------
# 阶段 1：构建
# go.mod 声明的是 `go 1.24`，这里用 1.25-alpine（更新的 1.25+ 均可）。
# 本模块**没有任何第三方依赖**，因此不需要 go mod download，也不需要 vendor。
# ---------------------------------------------------------------------------
FROM golang:1.25-alpine AS build

WORKDIR /src

# 先只拷贝依赖清单：本项目无第三方依赖，这一步几乎瞬间完成并命中缓存。
# （保留这一步是为了将来引入依赖时构建仍然高效。）
COPY go.mod ./

# 拷贝源码。web/ 是 //go:embed all:web 的内嵌前端，必须一起带上。
COPY main.go ./
COPY internal/ ./internal/
COPY web/ ./web/

# 静态编译：CGO_ENABLED=0 让产物不依赖 libc，可以放进 alpine 或 distroless。
# -trimpath 去掉构建机路径，-s -w 去掉符号表与调试信息（体积能小 25% 左右）。
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags "-s -w" \
      -o /out/homevault .

# ---------------------------------------------------------------------------
# 阶段 2：运行
# alpine 自带 BusyBox（有 sh / wget，方便 exec 进去排障与写探活脚本）。
# ---------------------------------------------------------------------------
FROM alpine:3.21

# ---------------------------------------------------------------------------
# 运行用户 UID / GID，可在构建时覆盖（详见 Dockerfile.full 的说明）：
#   docker build -f deploy/Dockerfile.lite \
#     --build-arg APP_UID=18090 --build-arg APP_GID=18090 -t homevault:lite .
# ---------------------------------------------------------------------------
ARG APP_UID=10001
ARG APP_GID=10001

# ca-certificates：进程需要访问外网时（例如将来做 WebDAV 客户端）用得上。
# tzdata：审计日志按天分文件、日志时间显示都依赖时区数据库。
# 不装 LibreOffice —— 需要 Office 预览请用 Dockerfile.full。
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -g "${APP_GID}" -S homevault \
 && adduser  -u "${APP_UID}" -S -D -H -G homevault homevault

# 引导配置不在这里写。
# 原因：`VOLUME /data` + 宿主机 bind mount 会在运行时用宿主目录覆盖整个 /data，
# 构建期写进 /data/config.ini 的内容会被盖掉。改由 /docker-entrypoint.sh
# 在启动时补一份容器场景正确的配置（存在则不覆盖，你改过的值会保留）。
RUN mkdir -p /data/HomeVaultSpace \
 && chown -R "${APP_UID}:${APP_GID}" /data

# 数据卷与工作目录：config.ini 的默认位置就是 WORKDIR。
VOLUME ["/data"]
WORKDIR /data

EXPOSE 8080

COPY --from=build /out/homevault /homevault
COPY deploy/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod 0755 /homevault /docker-entrypoint.sh

USER ${APP_UID}:${APP_GID}

# 用 exec 形式（不是 shell 形式），保证 homevault 能直接收到 docker stop 的
# SIGTERM 并优雅退出（保存 state.json）。entrypoint 内部最后是 exec。
ENTRYPOINT ["/docker-entrypoint.sh"]
