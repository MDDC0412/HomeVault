# =============================================================================
# homevault docker compose 环境变量（构建 + 端口）
#
# 用法：
#   cd deploy
#   cp env.compose.example .env     # 复制成 .env
#   vim .env                        # 按需修改下面的值
#   docker compose --profile full up -d --build
#
# docker compose 会自动读取同目录的 .env，本文件里所有变量都会传进
# docker-compose.yml 的 ${VAR:-默认值}。改这里不需要动 docker-compose.yml，
# 所以 git pull 时永远不会冲突。
#
# ⚠️ 本文件只负责「容器怎么跑」。应用本身的运行期参数（配额、限速、
#    回收站保留期等）在管理页面里改，立即生效，不需要重启容器。
# =============================================================================

# -----------------------------------------------------------------------------
# 宿主机访问方式（最常改的两项）
# -----------------------------------------------------------------------------

# 宿主机监听地址
#   0.0.0.0    局域网内其他设备可访问（家用 / 办公室内网选这个）
#   127.0.0.1  只有本机可访问（前面挂 Nginx / Caddy 反向代理时选这个）
HOST_BIND=0.0.0.0

# 宿主机端口：浏览器访问用的端口
#   容器内**固定**监听 18090（由 compose 的 HOMEVAULT_PORT 传给程序，
#   入口脚本会据此把 config.ini 的 listen 对齐，所以不用你手改）。
#   对外端口只由这里决定，ports 映射形如 HOST_PORT:18090。
HOST_PORT=18090

# -----------------------------------------------------------------------------
# 运行用户 UID / GID
#
# 容器内进程以这个 UID 运行，宿主机数据目录的属主必须一致，否则写不进去：
#   sudo chown -R 18090:18090 ./data-full
#
# 查你自己的 UID/GID：  id -u; id -g
# 若默认的 10001 已被别的服务占用，改成你自己的值。
# -----------------------------------------------------------------------------
APP_UID=18090
APP_GID=18090

# -----------------------------------------------------------------------------
# 构建相关
# -----------------------------------------------------------------------------

# Debian 软件源（只有 full 版构建时用得到，lite 版基于 alpine 不涉及）
#   mirrors.aliyun.com              阿里云，国内快（默认）
#   mirrors.tuna.tsinghua.edu.cn    清华，国内快
#   deb.debian.org                  官方，海外快
APT_MIRROR=mirrors.aliyun.com

# 时区：审计日志按天分文件、界面时间显示都依赖它
TZ=Asia/Shanghai
